  nmap <silent> [lhs] a
  let g:expected_maparg = Maparg('[lhs]', 'n')
  let g:original = esearch#keymap#restorable([['n', '[lhs]', 'b', {'silent': 1}]])
Then:
  AssertNotEqual Maparg('[lhs]', 'n'), g:expected_maparg
