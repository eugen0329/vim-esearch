Execute(#restorable restores <expr> keymap):
  nmap <expr> [lhs] a
  let g:expected_maparg = Maparg('[lhs]', 'n')
  let g:original = esearch#keymap#restorable([['n', '[lhs]', 'b', {'expr': 1}]])
Then:
  AssertNotEqual Maparg('[lhs]', 'n'), g:expected_maparg
  call g:original.restore()
  AssertEqual Maparg('[lhs]', 'n'), g:expected_maparg

Execute(#restorable restores "!" keymap):
  map! [lhs] a
  let g:expected_mapargs = [Maparg('[lhs]', 'i'), Maparg('[lhs]', 'c')]
  let g:original = esearch#keymap#restorable([['ic', '[lhs]', 'b']])
Then:
  AssertNotEqual [Maparg('[lhs]', 'i'), Maparg('[lhs]', 'c')], g:expected_mapargs
  call g:original.restore()
  AssertEqual [Maparg('[lhs]', 'i'), Maparg('[lhs]', 'c')], g:expected_mapargs

Execute(#restorable restores <script> keymap):
  fu! s:rhs(arg)
    let g:spy = a:arg
    return ''
  endfu
  nmap <expr><script> [lhs] <SID>rhs('a')
  let g:original = esearch#keymap#restorable([['n', '[lhs]', 'b', {'script': 1}]])
Then:
  norm [lhs]
  AssertEqual g:spy, 'original'
  call g:original.restore()
  norm [lhs]
  AssertEqual g:spy, 'a'

Execute(#restorable restores <script> keymap with multiple <SID>):
  fu! s:rhs(arg)
    let g:spy = a:arg
    return ''
  endfu
  nmap <expr><script> [lhs] <SID>rhs('a').<SID>rhs('z')
  let g:original = esearch#keymap#restorable([['n', '[lhs]', 'b', {'script': 1}]])
Then:
  norm [lhs]
  AssertEqual g:spy, 'original'
  call g:original.restore()
  norm [lhs]
  AssertEqual g:spy, 'z'

Execute(#restorable restores keymap with | in lhs):
  nmap [lhs<bar>] :let g:spy = 'a'<CR>
  let g:original = esearch#keymap#restorable([['n', '[lhs|]', 'b']])
Then:
  norm [lhs|]
  AssertEqual g:spy, 'original'
  call g:original.restore()
  norm [lhs|]
  AssertEqual g:spy, 'a'

Execute(#restorable restores keymap with | in rhs):
  nmap [lhs] :let g:spy = 'a'\|let g:spy = 'z'<CR>
  let g:original = esearch#keymap#restorable([['n', '[lhs]', 'b']])
Then:
  norm [lhs]
  AssertEqual g:spy, 'original'
  call g:original.restore()
  norm [lhs]
  AssertEqual g:spy, 'z'

Execute(#restorable restores "ic" keymaps defined separately for "i" and "c"):
  imap [lhs] a
  cmap [lhs] b
  let g:expected_mapargs = [Maparg('[lhs]', 'i'), Maparg('[lhs]', 'c')]
  let g:original = esearch#keymap#restorable([['ic', '[lhs]', 'z']])
Then:
  AssertNotEqual [Maparg('[lhs]', 'i'), Maparg('[lhs]', 'c')], g:expected_mapargs
  call g:original.restore()
  AssertEqual [Maparg('[lhs]', 'i'), Maparg('[lhs]', 'c')], g:expected_mapargs

Execute(#restorable restores a mapping without rhs, defined as a Lua callback):
  if has('nvim')
    lua vim.keymap.set('c', '[lhs]', function() vim.g.spy = 'a' end, {desc = 'lua rhs'})
    Assert !has_key(maparg('[lhs]', 'c', 0, 1), 'rhs'), 'precondition: no rhs in maparg()'
    " every maparg() call wraps the Lua function into a new funcref, so compare
    " the dicts without it and verify the callback by invoking the mapping
    let g:expected_maparg = MapargWithoutCallback('[lhs]', 'c')
    let g:original = esearch#keymap#restorable([['c', '[lhs]', 'b']])
  endif
Then:
  if has('nvim')
    AssertNotEqual MapargWithoutCallback('[lhs]', 'c'), g:expected_maparg
    call g:original.restore()
    AssertEqual MapargWithoutCallback('[lhs]', 'c'), g:expected_maparg
    call feedkeys(":[lhs]\<esc>", 'x')
    AssertEqual g:spy, 'a'
  endif

Execute(#restorable restores an <expr> Lua callback mapping with replace_keycodes):
  if has('nvim')
    lua vim.keymap.set('n', '[lhs]', function() vim.g.spy = 'a'; return '<Ignore>' end, {expr = true, replace_keycodes = true})
    let g:expected_maparg = MapargWithoutCallback('[lhs]', 'n')
    let g:original = esearch#keymap#restorable([['n', '[lhs]', 'b']])
  endif
Then:
  if has('nvim')
    AssertNotEqual MapargWithoutCallback('[lhs]', 'n'), g:expected_maparg
    call g:original.restore()
    AssertEqual MapargWithoutCallback('[lhs]', 'n'), g:expected_maparg
    norm [lhs]
    AssertEqual g:spy, 'a'
  endif

Execute(#restorable is a noop on restore when there was no original mapping):
  silent! unmap [lhs]
  let g:original = esearch#keymap#restorable([['n', '[lhs]', 'b']])
Then:
  AssertEqual maparg('[lhs]', 'n'), 'b'
  call g:original.restore()
  AssertEqual maparg('[lhs]', 'n'), ''
